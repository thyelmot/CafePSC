# Supabase configuration (Lấy từ Supabase Project Settings -> API)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Server-side (Dùng cho Vercel Serverless Functions trong thư mục /api)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Admin Authentication
ADMIN_PASSWORD="your-secure-admin-password"

# CSRF Secret (Chuỗi ngẫu nhiên bí mật bất kỳ, vd: 32 ký tự ngẫu nhiên)
CSRF_SECRET="change-this-to-a-secure-random-32-char-secret"

# Allowed Origins (CORS - Domain trang web của bạn trên Vercel hoặc '*')
ALLOWED_ORIGINS="*"

# Optional (Chỉ cần nếu chạy backend riêng bằng Node.js / Railway):
# VITE_API_URL="http://localhost:3001/api"
# VITE_SOCKET_URL="http://localhost:3001"
